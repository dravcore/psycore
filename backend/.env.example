# Database
DATABASE_URL="postgresql://psycore:psycore_dev_pass@localhost:5432/psycore_dev"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_SECRET="your-refresh-token-secret-change-this"
JWT_REFRESH_EXPIRES_IN="30d"

# Redis
REDIS_HOST="localhost"
REDIS_PORT=6379

# Google AI (Gemini) - Get your free API key from: https://aistudio.google.com/apikey
GOOGLE_AI_API_KEY="your-google-ai-api-key-here"

# OpenAI (Optional - if you prefer OpenAI instead of Google AI)
# OPENAI_API_KEY="your-openai-api-key-here"
# OPENAI_MODEL="gpt-4o-mini"

# API
PORT=3001
NODE_ENV="development"
